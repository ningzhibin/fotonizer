<Window x:Class="Fotonizer.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Fotonizer" Height="620" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets/fotonizer.ico" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentBrush}">
                        <Image Source="Assets/fotonizer.ico" Width="38" Height="38" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="欢迎使用 Fotonizer" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="一次设置，之后插上设备就自动整理照片。"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="选择照片库位置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="所有整理后的照片都会复制到这里。原始设备上的照片不会被修改。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationBox" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Browse_Click" />
                        </Grid>
                        <CheckBox x:Name="StartupScanCheck" Margin="0,14,0,0"
                                  Content="启动时扫描已连接的设备（推荐）" IsChecked="True" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="它会为你做什么" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                                   Text="• 监听 U 盘、存储卡和相机/手机，连接后自动导入新照片" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                                   Text="• 按拍摄时间重命名，并按年/月归档" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                                   Text="• 连拍时自动挑选最清晰、曝光最好的一张" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                                   Text="• 自动增强照片，并可上传到 Google 照片" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Text="所有处理都在本机完成；相同的照片不会重复导入。你可以随时在“设置”里调整或暂停。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Background="#FFF9EC" BorderBrush="#F3DFB6">
                    <StackPanel>
                        <TextBlock Text="第一次连接设备时" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="#6B5322" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#6B5322"
                                   Text="Fotonizer 会把设备上所有尚未导入过的照片复制进照片库，因此第一次可能会花一些时间。之后只会处理新增照片。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="#FBFCFE" Padding="32,14">
            <DockPanel>
                <Button Content="开始使用" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                        Click="Start_Click" MinWidth="120" IsDefault="True" />
                <TextBlock Text="稍后可以在“常规设置”中修改。" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
